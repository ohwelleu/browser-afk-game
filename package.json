{
  "name": "browser-afk-game",
  "version": "0.2.0",
  "description": "A tiny embeddable idle pixel-art game: one script tag, one <afk-game> element.",
  "private": true,
  "type": "module",
  "main": "./dist/afk-game.js",
  "module": "./dist/afk-game.mjs",
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "sprites": "node --experimental-strip-types --no-warnings=ExperimentalWarning scripts/sprites/cli.ts"
  },
  "devDependencies": {
    "@types/pngjs": "^6.0.5",
    "pngjs": "^7.0.0",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2",
    "vite": "^6.4.5",
    "vitest": "^4.1.12"
  }
}
